SELECT
    co.period AS 'Period',
    c.course_name AS 'Course Name',
    CONCAT(t.first_name, ' ', t.last_name) AS 'Teacher',
    rm.room_name AS 'Room'
FROM rosters ros
JOIN course_offerings co ON ros.offering_id = co.offering_id
JOIN courses c ON co.course_id = c.course_id
JOIN teachers t ON co.teacher_id = t.teacher_id
JOIN rooms rm ON co.room_id = rm.room_id
WHERE ros.student_id = 1
ORDER BY co.period ASC;