DROP PROCEDURE IF EXISTS GenerateOfferingsAssignments;

DELIMITER //

CREATE PROCEDURE GenerateOfferingsAssignments()
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE current_offering_id INT;
    DECLARE i INT;

    -- Cursor to iterate through every unique course offering dynamically
    DECLARE offering_cursor CURSOR FOR SELECT offering_id FROM course_offerings;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;

    OPEN offering_cursor;

    read_loop: LOOP
        FETCH offering_cursor INTO current_offering_id;
        IF done THEN
            LEAVE read_loop;
        END IF;

        -- =========================================================
        -- 1. INSERT 12 MINOR ASSESSMENTS (type_id = 1)
        -- =========================================================
        SET i = 1;
        WHILE i <= 12 DO
            INSERT INTO assignments (offering_id, assignment_name, type_id, max_points)
            VALUES (current_offering_id, CONCAT('Minor Assessment ', i), 1, 100);
            SET i = i + 1;
        END WHILE;

        -- =========================================================
        -- 2. INSERT 3 MAJOR ASSESSMENTS (type_id = 2)
        -- =========================================================
        SET i = 1;
        WHILE i <= 3 DO
            INSERT INTO assignments (offering_id, assignment_name, type_id, max_points)
            VALUES (current_offering_id, CONCAT('Major Assessment ', i), 2, 100);
            SET i = i + 1;
        END WHILE;

    END LOOP;

    CLOSE offering_cursor;
END //

DELIMITER ;

