DROP PROCEDURE IF EXISTS GenerateCourseOfferings;

DELIMITER //

CREATE PROCEDURE GenerateCourseOfferings()
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE current_course_id INT;
    DECLARE random_sections INT;
    DECLARE i INT;

    -- Cursor to loop through every course you populated
    DECLARE course_cursor CURSOR FOR SELECT course_id FROM courses;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;

    OPEN course_cursor;

    read_loop: LOOP
        FETCH course_cursor INTO current_course_id;
        IF done THEN
            LEAVE read_loop;
        END IF;

        -- 1. Randomly decide how many times this course is offered today (1 to 5)
        SET random_sections = FLOOR(1 + (RAND() * 5));

        -- 2. Create each section individually using loop variables
        SET i = 1;
        WHILE i <= random_sections DO
            INSERT INTO course_offerings (course_id, teacher_id, room_id, period)
            SELECT
                current_course_id,
                (SELECT teacher_id FROM teachers ORDER BY RAND() LIMIT 1), -- Random teacher
                (SELECT room_id FROM rooms ORDER BY RAND() LIMIT 1),       -- Random room
                FLOOR(1 + (RAND() * 10));                                  -- Random period (1-10)

            SET i = i + 1;
        END WHILE;

    END LOOP;

    CLOSE course_cursor;
END //

DELIMITER ;

CALL GenerateCourseOfferings();

DROP PROCEDURE IF EXISTS GenerateCourseOfferings;
