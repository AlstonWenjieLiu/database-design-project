#!/bin/bash

BASE_DIR="/home/$USER/Projects/DatabaseDesign"
APP_DIR="/home/$USER/Projects/DatabaseDesign/database_app"
FILES_DIR="/home/$USER/Projects/DatabaseDesign/database_app/files"

mkdir -p "$FILES_DIR"

touch "$BASE_DIR/launcher.sh"
touch "$BASE_DIR/uninstaller.sh"
touch "$APP_DIR/CAT"
touch "$FILES_DIR/create_tables.sh"
touch "$FILES_DIR/populate.sh"
touch "$FILES_DIR/populate_teachers.sh"
touch "$FILES_DIR/populate_rooms.sh"
touch "$FILES_DIR/populate_courses.sh"
touch "$FILES_DIR/populate_course_offerings.sh"
touch "$FILES_DIR/populate_students.sh"
touch "$FILES_DIR/populate_roster.sh"
touch "$FILES_DIR/populate_assignments.sh"
touch "$FILES_DIR/populate_grades.sh"

chmod +x "$BASE_DIR"/*.sh
chmod +x "$FILES_DIR"/*.sh

# downloading launcher.sh
cat <<'INSTALLER_EOF' > "$BASE_DIR/launcher.sh"
#!/bin/bash

# =========================================================
# 1. CREDENTIAL INITIALIZATION & ENVIRONMENT SETUP
# =========================================================
# Ask for Username
echo -n "Enter your MySQL Username: "
read USER

# Ask for OSIS (used as Password)
# The -s flag hides the typing so people can't see the password on screen
echo -n "Enter your OSIS (Password): "
read -s PASS
echo "" # Adds a new line since read -s doesn't

# Set the database variables based on the input
export USER="$USER"
export PASS="$PASS"
export DB="${USER}_db"
export HOST="127.0.0.1"
FILES_DIR="/home/$USER/Projects/DatabaseDesign/database_app/files"

echo "--- Welcome to BTHS's Administrative Portal, $USER ---"
echo ""

# =========================================================
# 2. INTERACTIVE MENU LOOP
# =========================================================
while true; do
    echo "========================================="
    echo "      BTHS ADMINISTRATION      "
    echo "========================================="
    echo "1) Build and Populate Database"
    echo "2) View Student Schedule"
    echo "3) View Teacher Schedule"
    echo "4) Exit Portal"
    echo "========================================="
    echo -n "Select an option [1-4]: "
    read OPTION

    case $OPTION in
        1)
            echo ""
            echo "⚠ WARNING: This will drop existing tables and wipe current data."
            echo -n "Are you sure? (y/n): "
            read CONFIRM
            if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                echo ""
                echo "--- Starting Execution ---"

                # Execute your structured population pipeline sequentially
                bash "$FILES_DIR/create_tables.sh"
                bash "$FILES_DIR/populate.sh"
                bash "$FILES_DIR/populate_teachers.sh"
                bash "$FILES_DIR/populate_rooms.sh"
                bash "$FILES_DIR/populate_students.sh"
                bash "$FILES_DIR/populate_courses.sh"
                bash "$FILES_DIR/populate_course_offerings.sh"
                bash "$FILES_DIR/populate_roster.sh"
                bash "$FILES_DIR/populate_assignments.sh"
                bash "$FILES_DIR/populate_grades.sh"

                echo ""
                echo "--- Sample Grade Report (Verification) ---"
                mysql -h "$HOST" -u "$USER" -p"$PASS" -D "$DB" -t -e "
                SELECT s.first_name, a.assignment_name, sa.grade
                FROM student_assignments sa
                JOIN students s ON sa.student_id = s.student_id
                JOIN assignments a ON sa.assignment_id = a.assignment_id
                LIMIT 10;"
                echo "✔ Database build and population process finished successfully."
            else
                echo "Build aborted."
            fi
            echo ""
            ;;

        2)
            echo ""
            echo -n "Enter Student ID (1-5000): "
            read SEARCH_STUDENT
            echo ""
            echo "--- Schedule for Student ID: $SEARCH_STUDENT ---"

            # Formats the student's personal daily room path cleanly
            mysql -h "$HOST" -u "$USER" -p"$PASS" -D "$DB" -t <<SQL_EOF
SELECT
    co.period AS 'Period',
    c.course_name AS 'Course Name',
    CONCAT(t.first_name, ' ', t.last_name) AS 'Teacher',
    rm.room_name AS 'Room'
FROM rosters ros
JOIN course_offerings co ON ros.offering_id = co.offering_id
JOIN courses c ON co.course_id = c.course_id
JOIN teachers t ON co.teacher_id = t.teacher_id
JOIN rooms rm ON co.room_id = rm.room_id
WHERE ros.student_id = $SEARCH_STUDENT
ORDER BY co.period ASC;
SQL_EOF
            echo ""
            ;;

        3)
            echo ""
            echo -n "Enter Teacher ID: "
            read SEARCH_TEACHER
            echo ""
            echo "--- Schedule for Teacher ID: $SEARCH_TEACHER ---"

            # Displays the single teacher room/course routing per period
            mysql -h "$HOST" -u "$USER" -p"$PASS" -D "$DB" -t <<SQL_EOF
SELECT
    co.period AS 'Period',
    c.course_name AS 'Course Name',
    rm.room_name AS 'Room'
FROM course_offerings co
JOIN courses c ON co.course_id = c.course_id
JOIN rooms rm ON co.room_id = rm.room_id
WHERE co.teacher_id = $SEARCH_TEACHER
ORDER BY co.period ASC;
SQL_EOF
            echo ""
            ;;

        4)
            echo ""
            echo "Exiting BTHS Administration Portal. Database connection severed safely."
            break
            ;;

        *)
            echo "❌ Invalid selection. Please pick a number from 1 to 4."
            echo ""
            ;;
    esac
done

INSTALLER_EOF

