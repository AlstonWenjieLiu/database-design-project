SELECT
    co.period AS 'Period',
    c.course_name AS 'Course Name',
    rm.room_name AS 'Room'
FROM course_offerings co
JOIN courses c ON co.course_id = c.course_id
JOIN rooms rm ON co.room_id = rm.room_id
WHERE co.teacher_id = 1  -- Change this ID to look up different teachers
ORDER BY co.period ASC;